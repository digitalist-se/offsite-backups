{
    "name": "digitalist-se/offsite-backups",
    "description": "Offsite database and files backups with restic, for Digitalist Drupal sites",
    "type": "drupal-module",
    "license": "GPL-3.0-or-later",
    "authors": [{"name": "Digitalist Sweden", "email": "jose.jimenez@digitalist.com"}],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-zlib": "*",
        "psr/log": "^3.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {"psr-4": {"Digitalist\\OffsiteBackup\\": "lib/"}},
    "autoload-dev": {"psr-4": {"Digitalist\\OffsiteBackup\\Tests\\": "tests/"}},
    "bin": ["bin/offsite-backup"],
    "extra": {"installer-name": "offsite_backup"},
    "config": {"sort-packages": true, "platform": {"php": "8.1.0"}}
}
